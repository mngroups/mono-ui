{
  "name": "@mono/ui",
  "version": "0.2.2",
  "description": "MoNo UI: shadcn/ui-based React components, tokens and Tailwind v4 styles.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./file-previewer": {
      "types": "./dist/file-previewer/index.d.ts",
      "import": "./dist/file-previewer/index.js"
    },
    "./file-upload": {
      "types": "./dist/file-upload/index.d.ts",
      "import": "./dist/file-upload/index.js"
    },
    "./styles.css": "./dist/styles/styles.css",
    "./theme-default.css": "./dist/styles/theme-default.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "lint-staged",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "prepack": "pnpm build",
    "prepare": "husky",
    "release": "release-it",
    "release:rc": "release-it --preRelease=rc"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,jsonc,css,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@mono/hooks": "^0.2.1",
    "@mono/utils": "^0.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.43.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^9.14.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "d3-scale": "^4.0.2",
    "docx-preview": "^0.4.1",
    "heic-to": "1.6.7",
    "pdfjs-dist": "^6.4.299",
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": "^7.60.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "d3-scale": {
      "optional": true
    },
    "docx-preview": {
      "optional": true
    },
    "heic-to": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@hookform/resolvers": "^5.9.2",
    "@release-it/conventional-changelog": "8.0.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "d3-scale": "^4.0.3",
    "docx-preview": "^0.4.1",
    "heic-to": "1.6.7",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "release-it": "17.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
